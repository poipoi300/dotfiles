// Exception for "Lunar Eclipse"
window-rule {
    match app-id="steam_app_2953480"
    open-fullscreen false
    open-floating true
}

window-rule {
    match app-id="org.gnome.Games"
    open-fullscreen true
    focus-ring { off; }
    border { off; }
}
