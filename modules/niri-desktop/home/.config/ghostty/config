# Ghostty: the default terminal (niri Mod+T, fuzzel, $TERMINAL).
command = /usr/bin/zsh
env = LANG=en_US.UTF-8
env = LC_ALL=en_US.UTF-8

# Colors generated by DankMaterialShell's matugen template (themes/dankcolors).
theme = dankcolors

# Ctrl+C copies when text is selected, otherwise it reaches the program (interrupt).
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
