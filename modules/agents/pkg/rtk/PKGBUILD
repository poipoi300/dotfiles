# RTK ("Rust Token Killer"), github.com/rtk-ai/rtk: CLI proxy that compresses shell command
# output for LLM agents. Official release tarball (static musl x86_64), pinned by sha256.
# Verified: the sha256 below equals the release's checksums.txt line for
# rtk-x86_64-unknown-linux-musl.tar.gz and GitHub's asset digest (v1.2.0).
# NOT the other crate named "rtk" (Rust Type Kit): `rtk gain` must show the savings dashboard.
#
# Edition: this is the default `rtk` download (Apache-2.0 CLI + the BUSL-1.1 compression engine,
# production use free). The Apache-2.0-only edition is `rtk-oss-x86_64-unknown-linux-musl.tar.gz`
# (hooks and filters, no engine) and installs the same /usr/bin/rtk; use it instead if the BUSL
# engine is unwanted (change the asset name, sha256 and conflicts).
# Bump: new tag -> update pkgver and the sha256 from the release's checksums.txt.
pkgname=rtk
pkgver=1.2.0
pkgrel=1
pkgdesc="RTK (Rust Token Killer): rewrites shell command output to save LLM tokens"
arch=(x86_64)
url="https://github.com/rtk-ai/rtk"
license=(Apache-2.0 LicenseRef-BUSL-1.1)
options=(!strip !debug)
conflicts=(rtk-oss)
source=("rtk-$pkgver-x86_64-unknown-linux-musl.tar.gz::$url/releases/download/v$pkgver/rtk-x86_64-unknown-linux-musl.tar.gz")
sha256sums=('70fee7b4a548c43dde94c77e2335550981b0bc2fb013691d8c8109b5bd0eda37')
noextract=("rtk-$pkgver-x86_64-unknown-linux-musl.tar.gz")

prepare() {
  mkdir -p src
  bsdtar -xf "rtk-$pkgver-x86_64-unknown-linux-musl.tar.gz" -C src
}

package() {
  install -Dm755 src/rtk "$pkgdir/usr/bin/rtk"
  install -Dm644 src/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/LICENSE-ENGINE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ENGINE"
}
