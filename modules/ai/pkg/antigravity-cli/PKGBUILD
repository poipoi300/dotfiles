# Google Antigravity CLI (`agy`). Official installer: https://antigravity.google/cli/install.sh (read, not run).
# It queries a manifest on an auto-updater Cloud Run service:
#   https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json
# which returns {version, url, sha512}; the url is a stable, versioned GCS object (below), and the script
# verifies the sha512 from that manifest. The sha512 here is that manifest value (re-verified locally).
# No licence file is shipped upstream. The CLI self-updates in the background if its install dir is writable.
# Bump: fetch the manifest above, copy version/url/sha512 into pkgver/_build/sha512sums.
# (glibc build; the manifest also has linux_amd64_musl, not used on Arch.)
pkgname=antigravity-cli
pkgver=1.5.13
_build=5999302598852608
pkgrel=1
pkgdesc="Google Antigravity command-line agent (agy), official prebuilt binary"
arch=(x86_64)
url="https://antigravity.google/cli"
license=(LicenseRef-custom)
depends=(glibc)
options=(!strip !debug)
source=("cli_linux_x64-$pkgver.tar.gz::https://storage.googleapis.com/antigravity-public/antigravity-cli/$pkgver-$_build/linux-x64/cli_linux_x64.tar.gz")
sha512sums=('014b37387703acab1f47cd532c8bb60167a6a3537b0f9891de03f1b1ffa9614307bc83c4b2f7551273b0877d722716b0cd9e26782f6b2a50705db4f05e18c68f')
noextract=("cli_linux_x64-$pkgver.tar.gz")

prepare() {
  mkdir -p bin
  bsdtar -xf "cli_linux_x64-$pkgver.tar.gz" -C bin antigravity
}

package() {
  install -Dm755 bin/antigravity "$pkgdir/usr/bin/agy"
}
