#!/bin/sh
# Run only while EasyEffects is stopped, before its service starts.
set -eu
config=${XDG_CONFIG_HOME:-"$HOME/.config"}/easyeffects/db/easyeffectsrc
mkdir -p "$(dirname "$config")"
sink=alsa_output.usb-SMSL_SMSL_USB_AUDIO-00.analog-stereo
# Discover the serial-bearing node locally; never store its identifier in the repo.
source=$(pactl -f json list sources | jq -er '[.[] | select(.name | startswith("alsa_input.usb-PreSonus_Revelator_IO_24_"))] | if length == 1 then .[0].name else error("Expected one Revelator input") end')
write() { kwriteconfig6 --file "$config" --group "$1" --key "$2" "$3"; }
write StreamOutputs useDefaultOutputDevice false
write StreamOutputs outputDevice "$sink"
write StreamInputs useDefaultInputDevice false
write StreamInputs inputDevice "$source"
write EffectsPipelines bypass false
write EffectsPipelines resetBypassOnDeviceChange false
# Rocker state is authoritative; device autoload would override Off on reconnect.
write Presets lastLoadedOutputPreset 'Output Off'
write Presets lastLoadedInputPreset 'Mic Off'
write Window noWindowAfterStarting true
write Window enableServiceMode true
