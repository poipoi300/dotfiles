-	const float referenceSize = static_cast<float> (this->getScene ().getWidth ());
-	float x = (depth.x + parallaxAmount) * displacement->x * referenceSize;
-	float y = (depth.y + parallaxAmount) * displacement->y * referenceSize;
+	// Scale each axis by its own scene dimension: using the width for y over-shifts vertically
+	// on wide scenes (3.6x on 32:9) and exposes the clear colour above and below.
+	const float sceneWidth = static_cast<float> (this->getScene ().getWidth ());
+	const float sceneHeight = static_cast<float> (this->getScene ().getHeight ());
+	float x = (depth.x + parallaxAmount) * displacement->x * sceneWidth;
+	float y = (depth.y + parallaxAmount) * displacement->y * sceneHeight;
+	// A layer that spans the whole scene on an axis (a background) may only move as far as it
+	// overhangs the scene edges on that axis, so the clear colour never shows behind it.
+	// m_pos holds the layer's edges: x = left, y = bottom, z = right, w = top.
+	if (this->m_pos.x <= 0.0f && this->m_pos.z >= sceneWidth)
+	    x = glm::clamp (x, -(this->m_pos.z - sceneWidth), -this->m_pos.x);
+	if (this->m_pos.y <= 0.0f && this->m_pos.w >= sceneHeight)
+	    y = glm::clamp (y, -(this->m_pos.w - sceneHeight), -this->m_pos.y);
 	mvp = glm::translate (mvp, { x, y, 0.0f });
     }
 
