# Windows-style middle-drag autoscroll at the evdev/uinput layer, so it works in every app.
# Packages the daemon and the session helper only: the settings GUI, its polkit action and
# midscroll-apply are left out (settings live in the module's /etc/midscroll.conf).
pkgname=midscroll
pkgver=1.15
pkgrel=3
pkgdesc="Windows-style middle-button drag autoscroll (evdev/uinput, works on Wayland and X11)"
arch=(any)
url="https://github.com/gnhen/midscroll"
license=(Unlicense)
depends=(python python-evdev python-gobject python-cairo gtk4 gtk4-layer-shell)
source=("$pkgname-$pkgver.tar.gz::https://github.com/gnhen/midscroll/archive/refs/tags/v$pkgver.tar.gz"
        niri.patch)
sha256sums=('8f0133be724b231ed7443fa1184491b92b5a071e5ac0a8b3a7d97300ed96c4fa'
            'f02b1a9dca59b7c28a288b1051a2d55bf6008c58538b67e65be64e7bc8c3a44c')

prepare() {
  cd "$pkgname-$pkgver"
  # niri support for the session helper: the focused window for the app blacklist comes from
  # niri IPC, the pointer position from a brief pointer-enter probe, and the marks are a ring at
  # the press point and a triangle at the hand pointing the way it scrolls.
  patch -p1 < "$srcdir/niri.patch"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 midscroll.py "$pkgdir/usr/bin/midscroll"
  install -Dm755 midscroll-overlay.py "$pkgdir/usr/bin/midscroll-overlay"
  install -Dm644 systemd/midscroll.service "$pkgdir/usr/lib/systemd/system/midscroll.service"
  install -Dm644 systemd/midscroll-overlay.service "$pkgdir/usr/lib/systemd/user/midscroll-overlay.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md SECURITY.md -t "$pkgdir/usr/share/doc/$pkgname"
}
