+def follow_niri_focus(sock, stop):
+    """Push the focused window's app_id from niri's event stream.
+
+    One long-lived `niri msg event-stream` instead of a query per second.
+    Returns False once the daemon connection is gone.
+    """
+    try:
+        proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
+                                stdout=subprocess.PIPE,
+                                stderr=subprocess.DEVNULL, text=True)
+    except OSError as err:
+        log.warning("niri event stream unavailable: %s", err)
+        return True
+    # Unblock the read below when the connection ends.
+    threading.Thread(target=lambda: (stop.wait(), proc.terminate()),
+                     daemon=True).start()
+    apps, focused, last = {}, None, None
+    try:
+        for line in proc.stdout:
+            try:
+                apps, focused = niri_focus_update(line, apps, focused)
+            except (ValueError, AttributeError, KeyError, TypeError):
+                continue  # not one JSON object of the expected shape
+            cls = apps.get(focused, "")
+            if cls != last:
+                last = cls
+                try:
+                    sock.sendall(b"focus " + cls.encode("utf-8", "replace")
+                                 + b"\n")
+                except OSError:
+                    return False
+    finally:
+        proc.terminate()
+        proc.wait()
+    return True
+
+
+def niri_focus_update(line, apps, focused):
+    """Apply one event-stream line to (app_id by window id, focused id)."""
+    (kind, ev), = json.loads(line).items()
+    if kind == "WindowsChanged":
+        apps = {w["id"]: w.get("app_id") or "" for w in ev["windows"]}
+        focused = next((w["id"] for w in ev["windows"]
+                        if w.get("is_focused")), None)
+    elif kind == "WindowOpenedOrChanged":
+        w = ev["window"]
+        apps[w["id"]] = w.get("app_id") or ""
+        if w.get("is_focused"):
+            focused = w["id"]
+    elif kind == "WindowClosed":
+        apps.pop(ev["id"], None)
+        if focused == ev["id"]:
+            focused = None
+    elif kind == "WindowFocusChanged":
+        focused = ev["id"]
+    return apps, focused
+
