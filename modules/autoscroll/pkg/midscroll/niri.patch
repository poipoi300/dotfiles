+    def draw_origin(_area, cr, width, height, *_data):
+        """Windows-style origin mark: a ring with four arrowheads."""
+        cx, cy = width / 2, height / 2
+        r = min(width, height) / 2 - 2
+        cr.arc(cx, cy, r, 0, 2 * math.pi)
+        cr.set_source_rgba(1, 1, 1, 0.88)
+        cr.fill_preserve()
+        cr.set_source_rgba(0, 0, 0, 0.75)
+        cr.set_line_width(1.5)
+        cr.stroke()
