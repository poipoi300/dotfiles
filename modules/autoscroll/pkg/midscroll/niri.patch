+    def make_direction_drawer(overlay):
+        """Triangle at the hand position, pointing the way it scrolls."""
+        def draw(_area, cr, width, height, *_data):
+            dx, dy = overlay.offset
+            ex = dx if abs(dx) > DEADZONE else 0
+            ey = dy if abs(dy) > DEADZONE else 0
+            cx, cy = width / 2, height / 2
+            if not (ex or ey):
+                # Inside the dead zone: nothing scrolls, show a dot.
+                cr.arc(cx, cy, 4, 0, 2 * math.pi)
+            else:
+                # Each axis scrolls at |offset| ** SPEED_EXP, so point
+                # along the resulting velocity, not the raw offset.
+                vx = math.copysign(abs(ex) ** SPEED_EXP, ex) if ex else 0.0
+                vy = math.copysign(abs(ey) ** SPEED_EXP, ey) if ey else 0.0
+                cr.translate(cx, cy)
