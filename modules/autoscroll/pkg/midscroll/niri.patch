+    def config_value(name, fallback):
+        """A number from the daemon's config, so the marks agree with it."""
+        try:
+            with open(CONFIG_PATH) as f:
+                for line in f:
+                    key, _, value = line.split("#", 1)[0].partition("=")
+                    if key.strip() == name:
+                        return float(value)
+        except (OSError, ValueError):
+            pass
+        return fallback
+
+    # Position lines carry the drag offset times GHOST_SCALE.
+    DEADZONE = (config_value("DEADZONE_PX", 15.0)
+                * config_value("GHOST_SCALE", 1.0))
+    SPEED_EXP = config_value("SPEED_EXP", 2.2)
+
+    def draw_origin(_area, cr, width, height, *_data):
+        """Windows-style origin mark: a ring with four arrowheads."""
+        cx, cy = width / 2, height / 2
+        r = min(width, height) / 2 - 2
+        cr.arc(cx, cy, r, 0, 2 * math.pi)
+        cr.set_source_rgba(1, 1, 1, 0.88)
+        cr.fill_preserve()
+        cr.set_source_rgba(0, 0, 0, 0.75)
+        cr.set_line_width(1.5)
+        cr.stroke()
+        cr.arc(cx, cy, 1.8, 0, 2 * math.pi)
+        cr.fill()
+        for k in range(4):
+            cr.save()
+            cr.translate(cx, cy)
+            cr.rotate(k * math.pi / 2)
+            cr.move_to(r - 3, 0)
+            cr.line_to(r - 8, -4)
+            cr.line_to(r - 8, 4)
+            cr.close_path()
+            cr.fill()
+            cr.restore()
+
+    def make_direction_drawer(overlay):
+        """Triangle at the hand position, pointing the way it scrolls."""
+        def draw(_area, cr, width, height, *_data):
+            dx, dy = overlay.offset
+            ex = dx if abs(dx) > DEADZONE else 0
+            ey = dy if abs(dy) > DEADZONE else 0
+            cx, cy = width / 2, height / 2
+            if not (ex or ey):
+                # Inside the dead zone: nothing scrolls, show a dot.
+                cr.arc(cx, cy, 4, 0, 2 * math.pi)
+            else:
+                # Each axis scrolls at |offset| ** SPEED_EXP, so point
+                # along the resulting velocity, not the raw offset.
+                vx = math.copysign(abs(ex) ** SPEED_EXP, ex) if ex else 0.0
+                vy = math.copysign(abs(ey) ** SPEED_EXP, ey) if ey else 0.0
+                cr.translate(cx, cy)
+                cr.rotate(math.atan2(vy, vx))
+                cr.move_to(12, 0)
+                cr.line_to(-7, -9)
+                cr.line_to(-7, 9)
+                cr.close_path()
+            cr.set_source_rgba(1, 1, 1, 0.92)
+            cr.fill_preserve()
+            cr.set_source_rgba(0, 0, 0, 0.8)
+            cr.set_line_width(1.5)
+            cr.stroke()
+        return draw
