#!/bin/sh
# T3 Code Nightly, a self-updating AppImage beside the stable one. Both share
# ~/.t3 and the Electron profile, so only one runs at a time.
app="$HOME/Applications/T3-Code-Nightly.AppImage"
if [ ! -x "$app" ]; then
    notify-send -a "T3 Code Nightly" "T3 Code Nightly is not installed" "Download the AppImage to $app" 2>/dev/null
    echo "t3code-nightly: $app not found" >&2
    exit 1
fi
exec "$app" "$@"
