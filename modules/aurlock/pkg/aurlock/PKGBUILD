# aurlock: the AUR helper config.toml names. Pinned to a reviewed commit on
# GitHub; to update, read the diff, then move _commit and pkgver together
# (pkgver is VERSION in config.mk at that commit).
pkgname=aurlock
pkgver=0.3.2
_commit=4e38bdb6fe774f5df5affbf62a41a59aaab0ad3a
pkgrel=1
pkgdesc="A minimal AUR helper that never installs an AUR package at a commit you haven't approved"
arch=(x86_64)
url="https://github.com/GrunclePug/aurlock"
license=(MIT)
depends=(bubblewrap git pacman sudo)
makedepends=(go)
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')   # git source pinned by commit hash

# The module cache stays in the build directory, verified against go.sum.
prepare() {
  cd $pkgname
  GOPATH="$srcdir/go" GOFLAGS=-modcacherw go mod download
}

# Pure Go, static, cgo off (its Makefile): makepkg's C flags don't apply.
build() {
  cd $pkgname
  export GOPATH="$srcdir/go"
  make GOFLAGS="-trimpath -mod=readonly -modcacherw"
}

package() {
  cd $pkgname
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
